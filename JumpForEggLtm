local function getEggInfo(name)
    local lowerName = name:lower()
    for _, data in ipairs(eggDatabase) do
        if lowerName:find(data.keyword) then
            local rarity = data.rarity
            local income = data.income
            local textColor = Color3.fromRGB(255, 255, 255)
            
            if rarity == "BRAINROT GOD" then
                textColor = Color3.fromRGB(255, 215, 0)
            elseif rarity == "MYTHIC" then
                textColor = Color3.fromRGB(255, 50, 50)
            elseif rarity == "SECRET" then
                textColor = Color3.fromRGB(255, 255, 255)
            end
            
            return rarity, income, textColor
        end
    end
    return "EGG", "", Color3.fromRGB(200, 200, 200)
end

