local islands = {
    {name = "Green Island", pos = Vector3.new(-458.2, 627.7, 91.2)},
    {name = "Desert Island", pos = Vector3.new(-446.0, 2270.3, 127.8)},
    {name = "Ice Island", pos = Vector3.new(-466.3, 4080.6, 22.1)},
    {name = "Cave Island", pos = Vector3.new(-405.5, 6583.8, 119.6)},
    {name = "Water Island", pos = Vector3.new(-376.3, 10311.6, 70.7)}
}

local function getNearestIsland(targetPos)
    local nearestPos = islands[1].pos
    local shortestDist = math.huge
    for _, island in ipairs(islands) do
        local dist = (targetPos - island.pos).Magnitude
        if dist < shortestDist then
            shortestDist = dist
            nearestPos = island.pos
        end
    end
    return nearestPos
end

