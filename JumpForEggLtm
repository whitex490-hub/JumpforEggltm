local function instantTpToNearestIsland(eggPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local nearestIslandPos = getNearestIsland(eggPos)
    hrp.CFrame = CFrame.new(nearestIslandPos + Vector3.new(0, 3, 0))
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
end

local function isValidEgg(obj)
    local nameLower = obj.Name:lower()
    local fullName = obj:GetFullName():lower()
    if nameLower:find("template") or nameLower:find("spawn") or nameLower:find("placement") or nameLower:find("folder") or nameLower:find("zone") then return false end
    if fullName:find("plot") or fullName:find("base") or fullName:find("owner") or fullName:find("housing") then return false end
    if not nameLower:find("egg") then return false end
    if obj:IsA("BasePart") or obj:IsA("Model") then return true end
    return false
end

local function setupEgg(egg)
    if not isValidEgg(egg) then return end
    local primaryPart = egg:IsA("Model") and (egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")) or egg
    if not primaryPart then return end

    local rarityText, incomeText, textColor = getEggInfo(egg.Name)

    -- 3D Billboard ESP with White Text & Black Outline/Stroke Layer for Secret
    if not primaryPart:FindFirstChild("EggTag") then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "EggTag"
        billboard.Size = UDim2.new(0, 160, 0, 65)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = primaryPart

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = egg.Name .. (rarityText ~= "" and "\n★ " .. rarityText .. " ★\n" .. incomeText or "")
        textLabel.TextColor3 = textColor
        textLabel.TextSize = 11
        textLabel.Font = Enum.Font.FredokaOne
        textLabel.Parent = billboard

        -- Black Layer / Outline Stroke
        local stroke = Instance.new("UIStroke")
        stroke.Thickness = (rarityText == "SECRET") and 3.5 or 2.5
        stroke.Color = Color3.fromRGB(0, 0, 0) -- Solid Black Layer
        stroke.Parent = textLabel
    end

    -- GUI List Button
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -5, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.Text = " 🥚 " .. egg.Name .. (rarityText ~= "" and " [" .. rarityText .. "] " .. incomeText or "")
    btn.TextColor3 = textColor
    btn.TextSize, btn.Font = 10, Enum.Font.GothamBold
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = ScrollingFrame

    if rarityText == "BRAINROT GOD" then
        table.insert(rgbButtons, btn)
    end

    local btnCorner = Instance.new("UICorner", btn)
    btnCorner.CornerRadius = UDim.new(0, 5)

    local conn
    conn = btn.MouseButton1Click:Connect(function()
        if primaryPart and primaryPart.Parent then
            instantTpToNearestIsland(primaryPart.Position)
        end
    end)

    local descendantConn
    descendantConn = egg.AncestryChanged:Connect(function()
        if not egg.Parent then
            btn:Destroy()
            if conn then conn:Disconnect() end
            if descendantConn then descendantConn:Disconnect() end
        end
    end)
end

for _, obj in pairs(Workspace:GetDescendants()) do
    pcall(function() setupEgg(obj) end)
end

